# Only agent.py needs this; the MCP server is driven by its host.
ANTHROPIC_API_KEY=sk-ant-...

# Everything below is optional: the four applications are auto-discovered.
# Set one only to override a discovery that got it wrong, or to pick between
# two installs.

# SIMKIT_OUT=E:\simkit\out
# SIMKIT_FREECAD=C:\Program Files\FreeCAD 1.1\bin\freecadcmd.exe
# SIMKIT_OPENROCKET=C:\Program Files\OpenRocket
# SIMKIT_OPENROCKET_JVM=C:\Program Files\OpenRocket\jre\bin\server\jvm.dll

# This machine has both OpenFOAM forks installed. Discovery picks the newest
# path; set this to pin one. The Foundation build (openfoam.org) and the ESI
# build (openfoam.com) use different dictionary names -- SimKit writes whichever
# dialect matches the install it finds.
# SIMKIT_OPENFOAM_BASHRC=/opt/openfoam13/etc/bashrc
# SIMKIT_OPENFOAM_BASHRC=/usr/lib/openfoam/openfoam2412/etc/bashrc
# SIMKIT_WSL_DISTRO=Ubuntu

# Fusion must be running with the SimKit add-in loaded.
# SIMKIT_FUSION_PORT=9720
# SIMKIT_FUSION_TIMEOUT=120

# Solvers can run a long time; this is the ceiling per run, in seconds.
# SIMKIT_OPENFOAM_TIMEOUT=1800
